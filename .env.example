# Public values
APP_URL=http://localhost:3000

# Supabase (hosted dev project). Server only: never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign session cookies
SESSION_SECRET=

# QR check-in (phone number and plate confirmation, checkout credential). Optional; anything unrecognised means off.
#   off   = the original check-in everywhere (the default)
#   pilot = the QR check-in only for the car parks listed in QR_SESSION_AREAS (their addresses, e.g. road)
#   on    = the QR check-in for every car park
QR_SESSION_FLOW=off
QR_SESSION_AREAS=

# First admin account, created by the seed step
ADMIN_PHONE=
ADMIN_PASSWORD=
