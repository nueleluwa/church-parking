{
  "name": "church-parking",
  "version": "1.0.0",
  "description": "Church Parking: digital parking passes for CCI",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:reset": "supabase db reset --linked",
    "db:seed-admin": "node --env-file=.env.local scripts/seed-admin.ts",
    "dev:test-service": "node --env-file=.env.local scripts/test-service.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@supabase/supabase-js": "^2.117.3",
    "html5-qrcode": "^2.3.8",
    "next": "^16.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "private": true
}
