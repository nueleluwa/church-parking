# Copy to /srv/church-parking/shared/.env.production.local on the server and fill in. Never commit the real file.
# Use the PRODUCTION Supabase project here, never the development one (decision D-09).

# From the production Supabase project: Project Settings, API.
SUPABASE_URL=https://YOUR-PRODUCTION-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# A long random value that signs sign-in cookies. Make one with:  openssl rand -base64 48
# Changing it signs everybody out.
SESSION_SECRET=

# The public address, with no slash at the end. QR signs and links are built from this.
APP_URL=https://churchparking.online

# Only used once, by `pnpm db:seed-admin`, to create the first admin (the parking lead).
# Remove the password from this file after the admin exists.
ADMIN_PHONE=+234XXXXXXXXXX
ADMIN_PASSWORD=
