# Written for you by deploy/db/install-db.sh on the server, at /srv/church-parking/shared/.env.production.local.
# This copy only shows what the file holds. Never commit the real file. All secrets are made on the server.

# The database lives on this same server (decision D-23). The app talks to it through the PostgREST
# interface behind a local-only door, using the same address style the hosted service used.
SUPABASE_URL=http://127.0.0.1:<local-door-port>
SUPABASE_SERVICE_ROLE_KEY=<a signed key made on the server>

# Signs the sign-in cookies. Changing it signs everybody out.
SESSION_SECRET=<made on the server>

# The public address, with no slash at the end. QR signs and links are built from this.
APP_URL=https://churchparking.online

# QR check-in rollout (optional, off when absent). off | pilot | on. With pilot, list the car park addresses to switch on.
# Change it only outside a service, then restart the app. See docs/GAP_ANALYSIS.md.
# QR_SESSION_FLOW=pilot
# QR_SESSION_AREAS=road

# Used only by the database tools (migrations, backups), never by the web app itself.
DATABASE_URL=postgres://church_owner:<password>@127.0.0.1:<database-port>/churchparking
DB_OWNER_PASSWORD=<made on the server>
POSTGREST_AUTHENTICATOR_PASSWORD=<made on the server>
POSTGREST_JWT_SECRET=<made on the server>

# Add these two lines only to create the first admin (the parking lead), then remove them:
# ADMIN_PHONE=+234XXXXXXXXXX
# ADMIN_PASSWORD=<at least 10 characters>
